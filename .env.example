# Ollama Cloud
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your-ollama-cloud-api-key
OLLAMA_TEMPERATURE=0.7

# Single-model backend (llm-python)
OLLAMA_MODEL=glm-5.2

# Multi-route backend (llm-multiroute) — all default to glm-5.2
OLLAMA_MODEL_CLASSIFY=glm-5.2
OLLAMA_MODEL_SENTIMENT=glm-5.2
OLLAMA_MODEL_SUMMARIZE=glm-5.2
OLLAMA_MODEL_INTENT=glm-5.2

# Server
SERVER_PORT=8080

# Langfuse observability (optional)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxx
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_FLUSH_AT=1
LANGFUSE_FLUSH_INTERVAL=1

# Optional: DeepEval judge (defaults to glm-5.2 on Ollama Cloud)
# DEEPEVAL_JUDGE_MODEL=glm-5.2
